# Generated .gitignore for Rust-Projects

# Rust build target directories
target/
*/target/
**/target/

# Cargo lock files (optional for libraries, kept or excluded)
# Cargo.lock

# Python bytecode
__pycache__/
*.py[cod]

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editor & IDE configs
.vscode/
.idea/
*.swp
*.swo
*~
.fleet/

# Backup and temp files
*.rs.bk
*.orig
*.bak
*.tmp
